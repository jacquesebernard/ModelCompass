# Copy to .env. All credentials stay in the Node server; never prefix them VITE_.
PORT=5173
HOST=127.0.0.1
# demo = synthetic, credential-free. live never falls back to synthetic data.
DATA_MODE=demo
AA_API_KEY=
# Discover with npm run mcp:inspect or Connections in the app. Do not guess names.
AA_MCP_TOOL=
AA_MCP_ARGS={}
# Full refreshes use multiple projected calls per page; budget for your plan.
AA_REFRESH_SECONDS=21600
AA_TIMEOUT_MS=120000
AA_CACHE_PATH=.cache/aa-snapshot.json
# Only enable after checking the rights for your intended use.
AA_USE_CONFIRMED=false
# No built-in AI credentials. A model supporting Responses structured outputs is required.
ADVISOR_API_KEY=
ADVISOR_MODEL=
ADVISOR_BASE_URL=https://api.openai.com/v1
# HTTPS required for remote providers; HTTP is allowed only on loopback.
# Output budget per provider call, including reasoning tokens when counted by the provider.
ADVISOR_MAX_OUTPUT_TOKENS=8192
ADVISOR_TIMEOUT_MS=45000
